{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    }
  },
  "Settlement": {
    "Sfg": {
      "Mode": "Local",
      "Host": "sfg.example.internal",
      "Port": 22,
      "Username": "alipay_settlement",
      "InboundPath": "data/sfg/inbound",
      "ProcessedPath": "data/sfg/processed",
      "ErrorPath": "data/sfg/error",
      "FilePattern": "*.csv",
      "PollIntervalSeconds": 300,
      "LedgerPath": "data/state/processed-files.json",
      "WorkingPath": "data/work"
    },
    "InternalSource": {
      "Path": "samples/internal/transactions.csv",
      "Delimiter": ",",
      "DateTimeFormat": "yyyy-MM-dd HH:mm:ss"
    },
    "Matching": {
      "AmountTolerance": 0.01,
      "SettlementWindowDays": 2,
      "HighSeverityAmount": 10000,
      "ReportMissingInAdvice": true,
      "SettledInternalStatuses": [ "SUCCESS", "SETTLED" ]
    },
    "Output": {
      "ReportsPath": "data/reports"
    },
    "Profiles": {
      "alipay-global": {
        "Provider": "Alipay",
        "FileNamePattern": "^ALIPAY_SETTLE_.*\\.csv$",
        "Encoding": "utf-8",
        "Delimiter": ",",
        "HasHeader": true,
        "SkipLeadingRows": 0,
        "TimeZone": "Asia/Shanghai",
        "ControlTotals": { "RowPrefix": "TOTAL", "CountIndex": 1, "AmountIndex": 2, "AmountField": "SettlementAmount" },
        "Fields": [
          { "Name": "TransactionId", "Source": "Partner_transaction_id", "Required": true, "MaxLength": 64 },
          { "Name": "ProviderTransactionId", "Source": "Transaction_id" },
          { "Name": "OriginalTransactionId", "Source": "Original_partner_transaction_id" },
          { "Name": "Amount", "Source": "Amount", "Type": "Decimal", "Required": true },
          { "Name": "RmbAmount", "Source": "Rmb_amount", "Type": "Decimal" },
          { "Name": "Fee", "Source": "Fee", "Type": "Decimal", "Default": "0" },
          { "Name": "SettlementAmount", "Source": "Settlement", "Type": "Decimal" },
          { "Name": "RmbSettlement", "Source": "Rmb_settlement", "Type": "Decimal" },
          { "Name": "Currency", "Source": "Currency", "Required": true, "Transform": "Upper" },
          { "Name": "SettlementCurrency", "Source": "Settlement_currency", "Default": "USD", "Transform": "Upper" },
          { "Name": "ExchangeRate", "Source": "Rate", "Type": "Decimal" },
          { "Name": "TransactionTime", "Source": "Payment_time", "Type": "DateTime", "Format": "yyyyMMddHHmmss|yyyy-MM-dd HH:mm:ss" },
          { "Name": "SettlementTime", "Source": "Settlement_time", "Type": "DateTime", "Format": "yyyyMMddHHmmss|yyyy-MM-dd HH:mm:ss" },
          { "Name": "TransactionType", "Source": "Type", "Required": true, "Transform": "Upper" },
          { "Name": "Status", "Source": "Status" },
          { "Name": "BatchId", "Source": "Settlement_batch_no" },
          { "Name": "Remarks", "Source": "Remarks" }
        ],
        "TransactionTypes": {
          "P": { "Type": "Payment" },
          "R": { "Type": "Refund" },
          "C": { "Type": "Cancel" },
          "CB": { "Type": "Chargeback" },
          "CBR": { "Type": "ChargebackReversal" },
          "F": { "Type": "Fee" },
          "A": { "Type": "Adjustment" }
        }
      },
      "alipay-plus": {
        "Provider": "Alipay+",
        "FileNamePattern": "^APLUS_SETTLE_.*\\.csv$",
        "Delimiter": "|",
        "HasHeader": true,
        "TimeZone": "UTC",
        "TrailerPrefixes": [ "#" ],
        "Fields": [
          { "Name": "BatchId", "Source": "settlementBatchId" },
          { "Name": "TransactionId", "Source": "paymentRequestId", "Required": true },
          { "Name": "ProviderTransactionId", "Source": "transactionId" },
          { "Name": "OriginalTransactionId", "Source": "originalPaymentRequestId" },
          { "Name": "TransactionType", "Source": "transactionType", "Required": true, "Transform": "Upper" },
          { "Name": "Amount", "Source": "transactionAmountValue", "Type": "Decimal", "Required": true },
          { "Name": "Currency", "Source": "transactionCurrency", "Required": true },
          { "Name": "SettlementAmount", "Source": "settlementAmountValue", "Type": "Decimal" },
          { "Name": "SettlementCurrency", "Source": "settlementCurrency" },
          { "Name": "Fee", "Source": "feeAmountValue", "Type": "Decimal", "Default": "0" },
          { "Name": "ExchangeRate", "Source": "quotePrice", "Type": "Decimal" },
          { "Name": "TransactionTime", "Source": "transactionTime", "Type": "DateTime", "Format": "yyyy-MM-dd'T'HH:mm:ss" },
          { "Name": "SettlementTime", "Source": "settlementTime", "Type": "DateTime", "Format": "yyyy-MM-dd'T'HH:mm:ss" },
          { "Name": "WalletBrand", "Source": "walletBrand" },
          { "Name": "PspId", "Source": "pspId" }
        ],
        "TransactionTypes": {
          "PAYMENT": { "Type": "Payment" },
          "REFUND": { "Type": "Refund" },
          "CANCEL": { "Type": "Cancel" },
          "DISPUTE": { "Type": "Chargeback" },
          "TAX": { "Type": "WithholdingTax", "Direction": "Debit", "MatchInternal": false }
        }
      }
    }
  }
}
